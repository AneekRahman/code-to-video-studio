  "title": "Rules for the first night",
  "fps": 30,
  "segments": [
    {
      "segment_id": "h1",
      "voice": "narrator",
      "text": "Day one. They said it would never reach our town.",
      "pause_after": 0.35
    },
    {
      "segment_id": "n2",
      "voice": "narrator",
      "text": "I was buying groceries when the screaming started.",
      "pause_after": 0.2
    },
    {
      "segment_id": "n3",
      "voice": "narrator",
      "text": "I dropped everything.",
      "pause_after": 0.15
    },
    {
      "segment_id": "n4",
      "voice": "narrator",
      "text": "And I ran.",
      "pause_after": 0.3
    },
    {
      "segment_id": "n5",
      "voice": "narrator",
      "text": "Door. Chain. Both deadbolts.",
      "pause_after": 0.6
    },
    {
      "segment_id": "b0",
      "voice": "broadcast",
      "text": "This is an emergency broadcast. Follow these rules to survive the night.",
      "pause_after": 0.45
    },
    {
      "segment_id": "r1",
      "voice": "broadcast",
      "text": "Rule one. Turn off every light.",
      "pause_after": 0.4
    },
    {
      "segment_id": "r2",
      "voice": "broadcast",
      "text": "Rule two. Never look out the windows. No matter what you hear.",
      "pause_after": 0.4
    },
    {
      "segment_id": "r3",
      "voice": "broadcast",
      "text": "Rule three. They cannot open doors. Do not open yours.",
      "pause_after": 0.4
    },
    {
      "segment_id": "r4",
      "voice": "broadcast",
      "text": "Rule four. If someone knocks with your voice, do not answer. You are already inside.",
      "pause_after": 0.4
    },
    {
      "segment_id": "d1",
      "voice": "double",
      "text": "Hey… it's me. Let me in.",
      "pause_after": 0.2
    }
  ],
