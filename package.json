{
  "name": "@openmausbot/video-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "studio": "node --experimental-strip-types src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/*.node-test.ts\"",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "fixture": "node --experimental-strip-types scripts/create-fixture.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@remotion/bundler": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "typescript": "5.8.3"
  }
}
