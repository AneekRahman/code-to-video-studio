{
  "name": "code-to-video-studio",
  "version": "1.1.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "studio": "node --experimental-strip-types --use-env-proxy src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests local-modes templates",
    "test": "node --experimental-strip-types --test \"tests/*.node-test.ts\" \"local-modes/*/tests/*.node-test.ts\"",
    "smoke": "node --experimental-strip-types --use-env-proxy scripts/smoke.ts",
    "fixture": "node --experimental-strip-types scripts/create-fixture.ts",
    "catalog:modes": "node --experimental-strip-types scripts/write-mode-catalog.ts",
    "test:modes": "node --experimental-strip-types --use-env-proxy scripts/test-modes.ts",
    "check:release": "node --experimental-strip-types scripts/check-release.ts"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "@remotion/three": "4.0.538",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.538",
    "three": "0.186.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.186.0",
    "oxlint": "1.80.0",
    "typescript": "5.8.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AneekRahman/code-to-video-studio.git"
  }
}
